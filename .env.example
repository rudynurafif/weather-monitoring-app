# ============================================================
# Weather Station Monitoring Platform - contoh environment
# Salin ke .env lalu sesuaikan:  cp .env.example .env
# ============================================================

# ---------- Database (TimescaleDB = PostgreSQL 16 + extension) ----------
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather_dev_password
POSTGRES_DB=weather
POSTGRES_PORT=5432

# Dipakai backend di dalam network docker (host = nama service "db").
# Untuk menjalankan migrasi dari mesin host, ganti "db" -> "localhost".
DATABASE_URL=postgresql://weather:weather_dev_password@db:5432/weather?schema=public

# ---------- Backend ----------
API_PORT=3001
NODE_ENV=development

# Semua timestamp DISIMPAN dan DIPROSES dalam UTC. Lihat README bagian Timezone.
TZ=UTC
# Timezone tampilan di frontend (WIB).
DISPLAY_TZ=Asia/Jakarta

# Secret untuk JWT user dashboard (WAJIB diganti di produksi).
JWT_SECRET=ganti_dengan_string_acak_minimal_32_karakter
JWT_EXPIRES_IN=12h

# Pepper untuk hashing API key device. Disimpan terpisah dari database, sehingga
# bocornya dump DB saja tidak cukup untuk memalsukan kredensial device.
DEVICE_KEY_PEPPER=ganti_dengan_string_acak_minimal_32_karakter

# ---------- Aturan ingestion ----------
# Payload dengan device_time lebih maju dari sekarang + toleransi ini akan ditandai
# (quality flag), bukan ditolak. Lihat F.3 kasus 1.
CLOCK_DRIFT_TOLERANCE_SECONDS=300
# Batas jumlah record dalam satu request batch. Lihat F.3 kasus 8.
MAX_BATCH_SIZE=500
# Rate limit endpoint ingestion, dihitung per device_id.
INGEST_RATE_LIMIT_PER_MINUTE=120
# Device dianggap offline jika tidak mengirim apa pun selama menit berikut.
DEVICE_OFFLINE_THRESHOLD_MINUTES=15

# ---------- Frontend ----------
WEB_PORT=3000
# URL API yang dipanggil dari browser (bukan dari dalam container).
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
NEXT_PUBLIC_DISPLAY_TZ=Asia/Jakarta

# ---------- Device simulator ----------
SIMULATOR_API_BASE_URL=http://localhost:3001
SIMULATOR_INTERVAL_SECONDS=60
